diff --git a/components/esp_hw_support/mspi/mspi_timing_tuning/include/esp_private/mspi_timing_tuning.h b/components/esp_hw_support/mspi/mspi_timing_tuning/include/esp_private/mspi_timing_tuning.h
--- a/components/esp_hw_support/mspi/mspi_timing_tuning/include/esp_private/mspi_timing_tuning.h
+++ b/components/esp_hw_support/mspi/mspi_timing_tuning/include/esp_private/mspi_timing_tuning.h
@@ -14,10 +14,28 @@
 #include <stdint.h>
 #include <stdbool.h>
 
+#include "sdkconfig.h"
+
 #ifdef __cplusplus
 extern "C" {
 #endif
 
+// Modified by Lichen (lichenos-why2025-badge #121, tools/idf-patches/0003): the PSRAM speed (80 or 120 MHz) is chosen at
+// PSRAM init from LP_SYSTEM_REG_LP_STORE15 instead of at compile time. Without the option every use below is the stock
+// CONFIG_SPIRAM_SPEED.
+#if CONFIG_SPIRAM_SPEED_RUNTIME_SELECT
+extern uint32_t g_mspi_psram_speed_mhz;      // 80 or 120, valid once esp_psram_impl_enable has started
+extern uint32_t g_mspi_psram_carrier_found;  // the raw word STORE15 held when it was read (and cleared)
+/**
+ * @brief Read LP_STORE15 (magic 0xC4A1 << 16 | 120 selects 120 MHz, anything else 80), clear it, remember both. Once only.
+ */
+void mspi_timing_psram_speed_select(void);
+#define MSPI_TIMING_PSRAM_SPEED_MHZ  (g_mspi_psram_speed_mhz)
+#define MSPI_TIMING_PSRAM_MPLL_MHZ   (g_mspi_psram_speed_mhz > 80 ? 480 : 320)   // 480 / 4 = 120, 320 / 4 = 80
+#else
+#define MSPI_TIMING_PSRAM_SPEED_MHZ  CONFIG_SPIRAM_SPEED
+#endif
+
 /**
  * @brief Make MSPI work under 20Mhz, remove the timing tuning required delays.
  * @param control_spi1  Select whether to control SPI1. For tuning, we need to use SPI1. After tuning (during startup stage), let the flash driver to control SPI1
diff --git a/components/esp_hw_support/mspi/mspi_timing_tuning/mspi_timing_tuning.c b/components/esp_hw_support/mspi/mspi_timing_tuning/mspi_timing_tuning.c
--- a/components/esp_hw_support/mspi/mspi_timing_tuning/mspi_timing_tuning.c
+++ b/components/esp_hw_support/mspi/mspi_timing_tuning/mspi_timing_tuning.c
@@ -39,6 +39,28 @@
 #include "esp_ipc_isr.h"
 #endif
 
+#if CONFIG_SPIRAM_SPEED_RUNTIME_SELECT
+#include "soc/lp_system_reg.h"
+// Modified by Lichen (lichenos-why2025-badge #121, 0003). Plain DRAM variables: PSRAM init runs before anything else could
+// set them, and the clock helpers that read them run from IRAM.
+uint32_t g_mspi_psram_speed_mhz = 80;
+uint32_t g_mspi_psram_carrier_found;
+
+void mspi_timing_psram_speed_select(void)
+{
+    static bool done;
+    if (done) {
+        return;
+    }
+    done = true;
+    uint32_t word = REG_READ(LP_SYSTEM_REG_LP_STORE15_REG);
+    g_mspi_psram_carrier_found = word;
+    g_mspi_psram_speed_mhz = (word == ((0xC4A1u << 16) | 120u)) ? 120 : 80;
+    // Cleared right away: a crash during a 120 MHz boot comes back at 80 unless the app arms it again
+    REG_WRITE(LP_SYSTEM_REG_LP_STORE15_REG, 0);
+}
+#endif
+
 #if CONFIG_ESPTOOLPY_FLASHFREQ_120M
 #define FLASH_FREQUENCY_MHZ 120
 #elif CONFIG_ESPTOOLPY_FLASHFREQ_80M
@@ -335,7 +357,7 @@
 #endif
 #if MSPI_TIMING_PSRAM_NEEDS_TUNING
     if (!is_flash) {
-        s_tuning_cfg_drv.psram_init_mspi(CONFIG_SPIRAM_SPEED);
+        s_tuning_cfg_drv.psram_init_mspi(MSPI_TIMING_PSRAM_SPEED_MHZ);
     }
 #endif
 
@@ -550,7 +572,7 @@
      */
     mspi_timing_config_set_flash_clock(FLASH_FREQUENCY_MHZ, MSPI_TIMING_SPEED_MODE_NORMAL_PERF, control_spi1);
 #if CONFIG_SPIRAM
-    mspi_timing_config_set_psram_clock(CONFIG_SPIRAM_SPEED, MSPI_TIMING_SPEED_MODE_NORMAL_PERF, control_spi1);
+    mspi_timing_config_set_psram_clock(MSPI_TIMING_PSRAM_SPEED_MHZ, MSPI_TIMING_SPEED_MODE_NORMAL_PERF, control_spi1);
 #endif  //#if CONFIG_SPIRAM
 #endif  //#if SOC_SPI_MEM_SUPPORT_TIMING_TUNING
 
