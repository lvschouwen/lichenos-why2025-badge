+    #if CONFIG_SPIRAM_SPEED_RUNTIME_SELECT
+    uint32_t mpll_mhz = MSPI_TIMING_PSRAM_MPLL_MHZ;   // Lichen #121: 320 at 80 MHz, 480 at 120 MHz
+#else
+    uint32_t mpll_mhz = MSPI_TIMING_MPLL_FREQ_MHZ;
+#endif
+    uint32_t freqdiv = mpll_mhz / MSPI_TIMING_CORE_CLOCK_DIV / psram_freq_mhz;
     assert(freqdiv > 0);
     ESP_DRAM_LOGD(TAG, "psram_freq_mhz: %" PRIu32 " mhz, bus clock div: %" PRIu32, psram_freq_mhz, freqdiv);
