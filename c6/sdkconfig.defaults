# ESP-Hosted co-processor for an MCU host (BadgeVMS on the P4)
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_CP=y
CONFIG_ESP_HOSTED_CP_FOR_MCU=y
CONFIG_ESP_HOSTED_CP_RPC_V2=y
CONFIG_ESP_HOSTED_CP_FEAT_WIFI=y
# WPA2/WPA3-Enterprise (#496): the P4 drives esp_eap_client_* over the esp_hosted RPC (host side:
# CONFIG_ESP_HOSTED_HOST_FEAT_WIFI_EXT_ENT in firmware/sdkconfig.defaults). PEAP-MSCHAPv2 and TTLS only (no
# certificates, no EAP-TLS): EAP-FAST, Suite-B 192 and TLS 1.3 stay off to keep the image small.
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=y
CONFIG_ESP_HOSTED_CP_FEAT_WIFI_EXT_ENT=y
CONFIG_ESP_HOSTED_CP_FEAT_WIFI_EXT_EAP_FAST=n
CONFIG_ESP_WIFI_SUITE_B_192=n
CONFIG_ESP_WIFI_EAP_TLS1_3=n
# No CA bundle (the owner's CA check uses a PEM on /storage) and nothing on the C6 serves TLS: esp_eap_client.c would
# otherwise link the full bundle, and the server half of mbedTLS is dead weight
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=n
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
# 802.11k/v (#495): neighbour reports and BSS transitions, so a multi-AP network can steer the badge to a better AP.
# The P4 sets rm_enabled/btm_enabled in the STA config; the P4's WIFI_RMT_11KV_SUPPORT stays off (nothing on the P4
# calls the esp_rrm/esp_wnm APIs, and it would only build the 11k/v supplicant into the P4 for nothing)
CONFIG_ESP_WIFI_11KV_SUPPORT=y

# Bluetooth LE for the P4 (#50): controller only, HCI rides the SDIO link (VHCI); NimBLE runs on the P4
CONFIG_ESP_HOSTED_CP_FEAT_BT=y
CONFIG_ESP_HOSTED_CP_BT_ENABLED=y
CONFIG_ESP_HOSTED_CP_FEAT_BT_HCI_VHCI=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_LE_HCI_INTERFACE_USE_RAM=y
CONFIG_BT_LE_SLEEP_ENABLE=y

# SDIO to the P4; the host is built for RX streaming (CONFIG_ESP_HOSTED_HOST_SDIO_RX_STREAMING_MODE)
CONFIG_EH_TRANSPORT_CP_SDIO=y
CONFIG_EH_TRANSPORT_CP_SDIO_MODE_STREAM=y
CONFIG_EH_TRANSPORT_CP_SDIO_HIGH_SPEED=y

# Same layout as the 2.x firmware, which BadgeVMS' C6 flasher writes
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.esp32c6.csv"

CONFIG_FREERTOS_HZ=1000
# Quiet second-stage bootloader (#39). The P4 writes this bootloader to the C6 too. Never touch CONFIG_BOOT_ROM_LOG_*
# (eFuse).
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_WIFI_NVS_ENABLED=y
CONFIG_ESP_CACHE_MALLOC=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_PERF=y

CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=20
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP_WIFI_RX_BA_WIN=32
CONFIG_ESP_WIFI_RX_IRAM_OPT=y
CONFIG_ESP_WIFI_IRAM_OPT=y

# Checksum every SDIO frame so link errors are dropped (and resent by TCP) instead of slipping through (#40);
# the host mirrors this at runtime
CONFIG_EH_TRANSPORT_CP_SDIO_CHECKSUM=y

# LoRa bridge to the P4 (#51)
CONFIG_ESP_HOSTED_CP_FEAT_PEER_DATA=y

# Reproducible image (#279): no build date in the app descriptor; PROJECT_VER is a content hash (c6/CMakeLists.txt)
CONFIG_APP_COMPILE_TIME_DATE=n
CONFIG_APP_PROJECT_VER_FROM_CONFIG=n

# #586: stack canary (-fstack-protector) in functions with char arrays or alloca; an overrun panics with a backtrace
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y
