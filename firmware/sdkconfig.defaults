# Lean badge firmware (#61). Values marked "as BadgeVMS" are copied from the top-level sdkconfig.defaults.

# Chip and flash
# The WHY2025 badge has an ESP32-P4 rev v1.0; esp-idf >= 5.5.6 defaults to rev >= v3.1, a different chip
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_5=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_PANIC_REBOOT_DELAY_SECONDS=5
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# Quiet second-stage bootloader (#39): faster boots and a smaller bootloader.bin (only 0x4e0 B were free in the 0x6000
# region, #112). Never touch CONFIG_BOOT_ROM_LOG_*: turning the ROM log off burns an eFuse.
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# PSRAM is ordinary malloc memory: big buffers, lwIP and the UI live there, internal RAM stays for DMA
CONFIG_SPIRAM=y
# 80 MHz (Lucas, 2026-11-01, #89). At 200 MHz this badge flips bit 8/9 of PSRAM words, 0->1, anywhere a pattern tickles
# the lane (the "weak cells" of #86 grew from 1.3 to 2.6 MB in a day; four LVGL crashes from flipped object metadata;
# a heap canary flipped 1 s after it was written). At 80 MHz the same memory is clean with no quarantine. Cost: PSRAM
# reads ~2x slower (the UI feels fine; numbers in #93), no internal RAM (the 12 KB once blamed on it were the c6link
# supervisor's task stacks, #14). psram_guard stays as the watchdog (canaries + boot check, #93); the quarantine
# machinery of #86 was removed in #93 (last commit with it: 7392597).
# 120 MHz trial 2026-11-01 to -02 (#94, ended by #120 below): not an IDF option; tools/idf-patches/0001-esp32p4-psram-120mhz.patch adds it
# (MPLL 480 / 4; the 80 MHz latency codes are good to 133 MHz); build.sh refuses to build 120 MHz without the patch. 133 MHz
# (400 / 3) does not work: an odd divider gives the DDR bus a 33 % duty clock and the chip is not found at boot. If the
# bit flips come back (`fw psram` canaries, `ui_check: FOUND`, CORRUPT HEAP), go back to CONFIG_SPIRAM_SPEED_80M=y.
# Back at 80 MHz since 2026-11-02 (#120, #121): at 120 MHz, DMA transfers between the SD card and PSRAM flipped bit 3
# at a fixed spot in every 1 KB (29 of 30 journal read passes; 0 of 150 at 80 MHz). The CPU-side canaries never saw it.
# Any new PSRAM clock needs a DMA-path test (`fw mesh hist scan 100`, #121) before it ships.
# No ECC: on P4 v1.0 it breaks (esp-idf #17855, OTA; here it crash-looped until power off). A mode change must never
# go out over Wi-Fi without someone at the badge to power-cycle it.
CONFIG_SPIRAM_SPEED_80M=y
# 80 or 120 MHz chosen at boot (#121): needs tools/idf-patches/0001 + 0003 in the IDF; without 0003 this symbol is unknown to
# Kconfig and the build is a plain 80 MHz one (Settings > PSRAM speed is then hidden). Default stays 80 MHz.
CONFIG_SPIRAM_SPEED_RUNTIME_SELECT=y
CONFIG_SPIRAM_USE_MALLOC=y
# A plain malloc of up to 4 KB is internal first, a bigger one PSRAM first (IDF default 16 KB, #261): internal RAM is
# nearly all DMA-capable, and every ordinary 4-16 KB block took it from esp_hosted's Wi-Fi frames. Safe because nothing
# that DMAs, runs in an ISR or runs with the cache off uses a plain malloc (#261 audit): those ask for caps
# (MALLOC_CAP_DMA / MALLOC_CAP_INTERNAL, lichen_alloc INTERNAL; FreeRTOS objects and stacks, mbedTLS are internal by
# their own caps). A new such buffer must ask for its caps too. 1024 is a bench trial (fw mem, fw ui perf bench).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Big statics that need no DMA or cache-off access live in PSRAM via EXT_RAM_BSS_ATTR (#107)
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# FreeRTOS: a 1 ms tick so 1-9 ms delays are not rounded to 10 ms; task list and per-task CPU for "fw mem"
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# FAT drive
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_USE_DYN_BUFFERS=y
# FatFs's heap buffers (window, file and LFN buffers, vfs context, mkdir's cluster clear) in PSRAM, cache-line aligned
# (#263): every SD transfer from or to PSRAM goes through sdcard.c's internal bounce buffer (never SDMMC DMA to PSRAM,
# #121), and esp_flash copies a PSRAM buffer itself for /storage. Internal DMA RAM only if PSRAM is full.
CONFIG_FATFS_ALLOC_PREFER_EXTRAM=y
CONFIG_FATFS_ALLOC_PREFER_ALIGNED_WORK_BUFFERS=y
# FatFs's file lock (#274): a delete, rename or write-open of a file another task has open fails with EACCES
# (FR_LOCKED) instead of corrupting the volume. One table for all volumes (ff.c: static FILESEM Files[FF_FS_LOCK],
# 16 B an entry, internal .bss), counting open files and open directories: 12 files (SD max_files 4 + /storage 8) and
# 8 directories (a listing, MeshCore's openNextFile, the shim's recursive remove). Past it an open fails with ENFILE.
# Concurrency (R0.16, ff.c): open, opendir, unlink and rename take the system mutex (mount_volume -> lock_volume(fs, 1))
# around chk_share/inc_share, so those are serialised across volumes; close's dec_share runs under the volume mutex
# only (the note at dec_share). A close on one volume racing an open on the other can at worst drop the new entry's
# lock (the protection we had before), never corrupt the FAT. No spurious FR_INT_ERR on open: inc_share runs right
# after chk_share under the same system mutex, so the free entry it found is still free. An EIO stays a card fault;
# ENFILE/EMFILE (table full) and EACCES (locked) do not count against the card (files_job, #274).
CONFIG_FATFS_FS_LOCK=20
# "fw sd format" names the card LICHEN (f_setlabel, #60)
CONFIG_FATFS_USE_LABEL=y

# lwIP (as BadgeVMS, minus its BadgeVMS-specific settings)
CONFIG_LWIP_LOCAL_HOSTNAME="badge"
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
CONFIG_FREERTOS_TIMER_TASK_AFFINITY_CPU0=y
CONFIG_LWIP_TCPIP_CORE_LOCKING=y
CONFIG_LWIP_TCPIP_CORE_LOCKING_INPUT=y
# CONFIG_LWIP_DHCPS is not set
CONFIG_LWIP_TCP_WND_DEFAULT=16384
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16

# esp_hosted 3.x host: C6 on SDIO slot 1, C6 EN on GPIO12 (GPIO13 is the C6 boot strap, held high by c6link, #2), RX streaming (the C6 build must match; as BadgeVMS)
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_HOST_SDIO_BUS_WIDTH_4=y
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CMD=33
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CLK=32
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D0=28
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D1=31
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D2=30
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D3=29
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=12
# The C6 answers on SDIO ~700 ms after its reset: with 300 or 500 ms the first card init failed (one E line per boot)
# and only the retry succeeded, at the same ~700 ms (#87)
CONFIG_ESP_HOSTED_HOST_CP_RESET_SETTLE_MS=700
CONFIG_ESP_HOSTED_HOST_SDIO_CLK_KHZ=40000
CONFIG_ESP_HOSTED_HOST_SDIO_RX_STREAMING_MODE=y
# The C6 flasher must release the C6 before esp_hosted starts (auto-init races it into a boot loop)
CONFIG_ESP_HOSTED_AUTO_CALL_INIT_BEFORE_APP_MAIN=n
CONFIG_ESP_HOSTED_HOST_FEAT_PEER_DATA=y
# A failed SDIO transfer posts TRANSPORT_FAILURE; Lichen's C6 supervisor recovers from it (#14) instead of
# esp_hosted aborting the P4
CONFIG_ESP_HOSTED_HOST_TRANSPORT_RESTART_ON_FAILURE=n
# Wi-Fi frames come from fixed pools reserved at link-up (#260); the queue sizes are the pool depths. The blocks go to
# PSRAM (RX STREAMING mode copies every frame, no DMA touches a block; internal DMA only if PSRAM is full): TX depth x
# 1600 B + RX depth x 1536 B (10/10: 31360 B PSRAM). Internal DMA keeps one 1536 B TX write buffer plus the RX staging
# buffers as before. 10/10 is a start; the bench measures throughput at 20/12/8/6 and picks the smallest within ~10 %.
CONFIG_ESP_HOSTED_HOST_SDIO_FRAME_POOLS=y
CONFIG_ESP_HOSTED_HOST_SDIO_TX_POOL_WAIT_MS=5
CONFIG_ESP_HOSTED_HOST_SDIO_TX_Q_SIZE=10
CONFIG_ESP_HOSTED_HOST_SDIO_RX_Q_SIZE=10
CONFIG_WIFI_RMT_STATIC_TX_BUFFER=y
# CONFIG_WIFI_RMT_SOFTAP_SUPPORT is not set
# The Wi-Fi side runs on the C6, which has no PSRAM: don't ask it for TX cache buffers
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=0
CONFIG_WIFI_RMT_CACHE_TX_BUFFER_NUM=0

# LVGL: its heap is PSRAM (board/lv_mem_psram.c, #80), fonts for a 720x720 panel
CONFIG_LV_USE_CUSTOM_MALLOC=y
# Lichen's own fonts (#16) come from the assets partition: in memory-mapped files, RLE-compressed
CONFIG_LV_USE_FS_MEMFS=y
CONFIG_LV_FS_MEMFS_LETTER=77
CONFIG_LV_USE_FONT_COMPRESSED=y
# The built-in Montserrat is the fallback when a font file is missing or damaged
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
# Lichen's name and the boot screen's current step (#66)
CONFIG_LV_FONT_MONTSERRAT_40=y

# QR codes (#153): lv_qrcode with qrcodegen (MIT), only for the QR code screen (contact and channel links, the QR code app)
CONFIG_LV_USE_QRCODE=y

# Screenshots (#30): lv_snapshot renders the screen into a PSRAM buffer
CONFIG_LV_USE_SNAPSHOT=y

# Run code and read-only data from PSRAM: flash writes (settings, file pushes, updates) then no longer suspend the
# caches, which disturbed the panel's scan-out from its PSRAM framebuffer as yellow flashes (#61)
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
# IRAM back for code that needs it (#265): the ring buffer's ISR functions (3.4 KB; used only by the UART and USB-serial-
# JTAG drivers, whose interrupts are not IRAM: flags 0, UART_ISR_IN_IRAM off) and the I2C master ISR (0.9 KB; its
# interrupt is not IRAM either, I2C_ISR_IRAM_SAFE off) run from flash/PSRAM like the rest of those drivers
CONFIG_RINGBUF_PLACE_ISR_FUNCTIONS_INTO_FLASH=y
# CONFIG_I2C_MASTER_ISR_HANDLER_IN_IRAM is not set
# CONFIG_LVGL_PORT_ENABLE_PPA is not set
# #95 (measured at 120 MHz PSRAM, PSRAM is at 80 MHz again since #120): the CPU rotates a 720x80 strip faster than the blocking PPA pass through its second PSRAM buffer (flush 2.3 vs 3.7 ms/strip, scroll 13.9 vs 12.5 fps)

# Keep every crash (#74): the core dump goes to the coredump partition. ELF format and a SHA256 check are the only
# ones left in ESP-IDF 6.1 (no CRC32 choice). The dump holds every task's stack, so it must fit in 128 KB.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_MAX_TASKS_NUM=48

# RTC slow clock from Y1 (32.768 kHz crystal on GPIO0/1, #63): the internal RC is ~9% off and drifts, which spoils the
# time carried across a warm reset. If the crystal does not start, IDF falls back to the RC at boot.
CONFIG_RTC_CLK_SRC_EXT_CRYS=y
CONFIG_RTC_CLK_CAL_CYCLES=1024

# #89: light poisoning so a double free or a free of a bad pointer aborts at the culprit (8 B per block)
CONFIG_HEAP_POISONING_LIGHT=y
# #256: the alloc hook names who took the most internal RAM when the DMA low-water mark fell (lichen_os/dma_watch.c)
CONFIG_HEAP_USE_HOOKS=y
# #267: heap code (multi_heap, tlsf, heap_caps, the hook above) runs from PSRAM like the rest of the image: ~9 KB of
# IRAM back for the DMA heap. Safe only while no heap call runs with the cache off: with XIP from PSRAM a flash write
# keeps the cache on unless a permanent flash mmap is open (spi_flash_os_func_app.c spi1_start; we never keep one,
# #31), and no IRAM ISR or cache-off window of ours allocates or frees. A new ESP_INTR_FLAG_IRAM handler or IRAM_ATTR
# function must not call malloc/free/heap_caps_* (or turn this back off).
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y

# #116: encrypted NVS is built in but off; docs/nvs-encryption.md before turning it on (it never burns a key by itself)
# CONFIG_LICHEN_NVS_ENCRYPT is not set

# #156: mDNS answers to lichen-xxxx.local on the Wi-Fi station only. Task stack and its buffers live in PSRAM (internal
# RAM is tight, #107); browsing, the CLI and the AP/Ethernet netifs are not used.
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
# CONFIG_MDNS_ENABLE_BROWSE is not set
# CONFIG_MDNS_ENABLE_CONSOLE_CLI is not set
# CONFIG_MDNS_PREDEF_NETIF_AP is not set
# CONFIG_MDNS_PREDEF_NETIF_ETH is not set
CONFIG_MDNS_MAX_INTERFACES=2
CONFIG_MDNS_MAX_SERVICES=2
